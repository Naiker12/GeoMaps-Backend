# Copia este archivo a .env y completa tus credenciales. No publiques .env.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST:5432/postgres
SUPABASE_URL=https://TU_REFERENCIA.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_ANON
SUPABASE_JWT_SECRET=TU_SECRETO_JWT
# SUPABASE_JWT_ISSUER=https://TU_REFERENCIA.supabase.co/auth/v1
SUPABASE_SERVICE_KEY=TU_CLAVE_SERVICE_ROLE
FRONTEND_URL=http://localhost:5173
DEBUG=false
# Clave secreta para firmar los JWTs del backend (genera con: openssl rand -hex 64)
SECRET_KEY=GENERA_UNA_CLAVE_ALEATORIA_DE_64_BYTES_HEX
# GOOGLE_API=
# Clave Fernet para cifrar API keys de proveedores de IA (Base64 URL-safe 32 bytes).
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_PROVIDER_ENCRYPTION_KEY=
# REDIS_URL=redis://localhost:6379
# Redis es obligatorio para el estado de trabajos de reportes.

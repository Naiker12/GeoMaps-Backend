# Copia este archivo a .env y completa tus credenciales. No publiques .env.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST:5432/postgres
SUPABASE_URL=https://TU_REFERENCIA.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_ANON
SUPABASE_JWT_SECRET=TU_SECRETO_JWT
# SUPABASE_JWT_ISSUER=https://TU_REFERENCIA.supabase.co/auth/v1
SUPABASE_SERVICE_KEY=TU_CLAVE_SERVICE_ROLE
FRONTEND_URL=http://localhost:5173
DEBUG=false
# GOOGLE_API=
# REDIS_URL=redis://localhost:6379
# Redis es obligatorio para API keys con rate_limit_rpm configurado.
# Sin acceso a Redis, esas llaves reciben HTTP 503; rate_limit_rpm=null no usa Redis.
